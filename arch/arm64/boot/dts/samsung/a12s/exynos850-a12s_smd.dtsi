/ {
	fragment@smd {
		target-path = "/";
		__overlay__ {
			smd: samsung_mobile_device {
				compatible = "simple-bus";
				abc_hub {
					compatible = "samsung,abc_hub";
					status = "okay";
					bootc {
						bootc,time_spec_eng = <0x186a0>;
						bootc,time_spec_fac = <0x186a0>;
						bootc,time_spec_user = <0x186a0>;
					};
				};
				sec_battery: battery {
					battery,adc_check_count = <0x05>;
					battery,age_data = <0x00 0x10fe 0x10b8 0x109a 0x5d 0x12c 0x10ea 0x10a4 0x1086 0x5c 0x190 0x10d6 0x1090 0x1072 0x5b 0x2bc 0x10c2 0x107c 0x105e 0x5a 0x3e8 0x1090 0x104a 0x102c 0x59>;
					battery,batt_data_version = <0x01>;
					battery,batt_temp_adj_gap_inc = <0x14>;
					battery,battery_check_type = <0x00>;
					battery,battery_full_capacity = <0x1388>;
					battery,cable_check_type = <0x04>;
					battery,cable_source_type = <0x01>;
					battery,charger_name = "sm5714-charger";
					battery,charging_reset_time = <0x00>;
					battery,charging_total_time = <0x3840>;
					battery,chg_charging_limit_current = <0x578>;
					battery,chg_float_voltage = <0x10fe>;
					battery,chg_gpio_full_check = <0x00>;
					battery,chg_high_temp = <0x226>;
					battery,chg_high_temp_recovery = <0x1fe>;
					battery,chg_input_limit_current = <0x3e8>;
					battery,chg_polarity_full_check = <0x01>;
					battery,chg_temp_check_type = <0x02>;
					battery,chg_temp_table_adc = <0x10b 0x15b 0x1b3 0x1ef 0x23f 0x2a9 0x318 0x39a 0x416 0x4c6 0x578 0x654 0x715 0x7f4 0x8c6 0x988 0xa57 0xb51 0xc17 0xcda 0xd6f 0xde4 0xe44>;
					battery,chg_temp_table_data = <0x384 0x352 0x320 0x2ee 0x2bc 0x28a 0x258 0x226 0x1f4 0x1c2 0x190 0x15e 0x12c 0xfa 0xc8 0x96 0x64 0x32 0x00 0xffffffce 0xffffff9c 0xffffff6a 0xffffff38>;
					battery,chg_thermal_source = <0x02>;
					battery,chip_vendor = "LSI";
					battery,cisd_alg_index = <0x08>;
					battery,cisd_max_voltage_thr = <0x1388>;
					battery,cv_data = <0x8db 0x37a 0x618 0x846 0x384 0x5be 0x7d1 0x38e 0x5a0 0x703 0x398 0x53b 0x660 0x3a2 0x4d2 0x596 0x3ac 0x467 0x494 0x3b6 0x377 0x41a 0x3c0 0x31d 0x389 0x3ca 0x2a4 0x2a2 0x3d4 0x186 0x225 0x3de 0x78 0x1d7 0x3e8 0x00>;
					battery,expired_time = <0x35e8>;
					battery,fgsrc_switch_name = "sm5714-fuelgauge";
					battery,fuelgauge_name = "sm5714-fuelgauge";
					battery,full_check_count = <0x01>;
					battery,full_check_type = <0x02>;
					battery,full_check_type_2nd = <0x02>;
					battery,full_condition_soc = <0x5d>;
					battery,full_condition_type = <0x09>;
					battery,full_condition_vcell = <0x109a>;
					battery,health_condition = <0x384 0x00 0x4b0 0x00 0x5dc 0x00>;
					battery,high_temp_float = <0x1036>;
					battery,high_temp_topoff = <0xfa>;
					battery,hv_charging_total_time = <0x2a30>;
					battery,ignore_cisd_index = <0x00 0x00>;
					battery,ignore_cisd_index_d = <0x00 0x50>;
					battery,low_temp_float = <0x10fe>;
					battery,low_temp_topoff = <0xfa>;
					battery,max_charging_charge_power = <0x3a98>;
					battery,max_charging_current = <0x866>;
					battery,max_input_current = <0xbb8>;
					battery,max_input_voltage = <0x2328>;
					battery,mix_high_chg_temp = <0x1f4>;
					battery,mix_high_temp = <0x1a4>;
					battery,mix_high_temp_recovery = <0x186>;
					battery,monitor_initial_count = <0x00>;
					battery,normal_charging_total_time = <0x4650>;
					battery,overheatlimit_recovery = <0x2a8>;
					battery,overheatlimit_threshold = <0x2bc>;
					battery,ovp_uvlo_check_type = <0x03>;
					battery,pd_charging_charge_power = <0x3a98>;
					battery,polling_time = <0x0a 0x1e 0x1e 0x1e 0xe10>;
					battery,polling_type = <0x01>;
					battery,pre_afc_input_current = <0x1f4>;
					battery,pre_afc_work_delay = <0x7d0>;
					battery,pre_wc_afc_input_current = <0x1f4>;
					battery,pre_wc_afc_work_delay = <0xfa0>;
					battery,prepare_ta_delay = <0x00>;
					battery,recharge_check_count = <0x01>;
					battery,recharge_condition_soc = <0x62>;
					battery,recharge_condition_type = <0x04>;
					battery,recharge_condition_vcell = <0x10b8>;
					battery,recharging_expired_time = <0x1518>;
					battery,recharging_total_time = <0x1518>;
					battery,rp_current_abnormal_rp3 = <0x708>;
					battery,rp_current_rdu_rp3 = <0x834>;
					battery,rp_current_rp1 = <0x1f4>;
					battery,rp_current_rp2 = <0x5dc>;
					battery,rp_current_rp3 = <0xbb8>;
					battery,siop_charging_limit_current = <0x3e8>;
					battery,siop_hv_charging_limit_current = <0x3e8>;
					battery,siop_hv_input_limit_current = <0x2bc>;
					battery,siop_hv_input_limit_current_2nd = <0x226>;
					battery,siop_input_limit_current = <0x4b0>;
					battery,sleep_mode_limit_current = <0x1f4>;
					battery,standard_curr = <0x866>;
					battery,store_mode_charging_max = <0x46>;
					battery,store_mode_charging_min = <0x3c>;
					battery,swelling_drop_float_voltage = <0x1036>;
					battery,swelling_high_rechg_voltage = <0xfa0>;
					battery,swelling_high_temp_block = <0x19a>;
					battery,swelling_high_temp_recov = <0x186>;
					battery,swelling_low_rechg_voltage = <0x1068>;
					battery,swelling_low_temp_block_1st = <0x96>;
					battery,swelling_low_temp_block_2nd = <0x32>;
					battery,swelling_low_temp_recov_1st = <0xaa>;
					battery,swelling_low_temp_recov_2nd = <0x46>;
					battery,technology = <0x02>;
					battery,temp_adc_type = <0x01>;
					battery,temp_check_count = <0x01>;
					battery,temp_check_type = <0x02>;
					battery,temp_high_recovery_event = <0x1e0>;
					battery,temp_high_recovery_lpm = <0x1e0>;
					battery,temp_high_recovery_normal = <0x1e0>;
					battery,temp_high_threshold_event = <0x1f4>;
					battery,temp_high_threshold_lpm = <0x1f4>;
					battery,temp_high_threshold_normal = <0x1f4>;
					battery,temp_highlimit_recovery_event = <0x30c>;
					battery,temp_highlimit_recovery_lpm = <0x30c>;
					battery,temp_highlimit_recovery_normal = <0x30c>;
					battery,temp_highlimit_threshold_event = <0x320>;
					battery,temp_highlimit_threshold_lpm = <0x320>;
					battery,temp_highlimit_threshold_normal = <0x320>;
					battery,temp_low_recovery_event = <0x14>;
					battery,temp_low_recovery_lpm = <0x14>;
					battery,temp_low_recovery_normal = <0x14>;
					battery,temp_low_threshold_event = <0x00>;
					battery,temp_low_threshold_lpm = <0x00>;
					battery,temp_low_threshold_normal = <0x00>;
					battery,temp_table_adc = <0x5a 0x6e 0x7c 0x91 0xa6 0xc9 0xed 0x114 0x152 0x1a5 0x1f5 0x262 0x2ca 0x357 0x3fb 0x4a2 0x573 0x667 0x775 0x885 0x992 0xa8d 0xb5a>;
					battery,temp_table_data = <0x384 0x352 0x320 0x2ee 0x2bc 0x28a 0x258 0x226 0x1f4 0x1c2 0x190 0x15e 0x12c 0xfa 0xc8 0x96 0x64 0x32 0x00 0xffffffce 0xffffff9c 0xffffff6a 0xffffff38>;
					battery,thermal_source = <0x02>;
					battery,ttf_capacity = <0x11d5>;
					battery,ttf_hv_charge_current = <0x7c1>;
					battery,usb_charging_total_time = <0x8ca0>;
					battery,usb_temp_check_type = <0x00>;
					battery,usb_thermal_source = <0x05>;
					battery,vendor = "Battery";
					battery,wc_full_input_limit_current = <0x64>;
					battery,wire_cold_cool3_thresh = <0x00>;
					battery,wire_cool1_current = <0x8fc>;
					battery,wire_cool1_normal_thresh = <0x96>;
					battery,wire_cool2_cool1_thresh = <0x96>;
					battery,wire_cool2_current = <0x352>;
					battery,wire_cool3_cool2_thresh = <0x32>;
					battery,wire_cool3_current = <0x1ea>;
					battery,wire_normal_warm_thresh = <0x1a4>;
					battery,wire_warm_current = <0x514>;
					battery,wire_warm_overheat_thresh = <0x1f4>;
					battery,wireless_cc_cv = <0x55>;
					battery,wireless_otg_input_current = <0x384>;
					battery,wpc_charging_limit_current = <0x3e8>;
					battery,wpc_high_recovery_normal = <0x1ae>;
					battery,wpc_high_temp = <0x17c>;
					battery,wpc_high_temp_recovery = <0x168>;
					battery,wpc_high_threshold_normal = <0x1c2>;
					battery,wpc_input_limit_current = <0x258>;
					battery,wpc_lcd_on_high_temp = <0x17c>;
					battery,wpc_lcd_on_high_temp_rec = <0x168>;
					battery,wpc_lcd_on_input_limit_current = <0x1c2>;
					battery,wpc_low_recovery_normal = <0x14>;
					battery,wpc_low_threshold_normal = <0x00>;
					battery,wpc_store_charging_limit_current = <0x190>;
					battery,wpc_store_high_temp = <0x168>;
					battery,wpc_store_high_temp_recovery = <0x154>;
					battery,wpc_store_lcd_on_charging_limit_current = <0x190>;
					battery,wpc_store_lcd_on_high_temp = <0x168>;
					battery,wpc_store_lcd_on_high_temp_rec = <0x12c>;
					battery,wpc_temp_check_type = <0x00>;
					battery,wpc_temp_control_source = <0x01>;
					battery,wpc_temp_lcd_on_control_source = <0x01>;
					battery,wpc_thermal_source = <0x05>;
					compatible = "samsung,sec-battery";
					io-channel-names = "adc-temp\0adc-chg-temp\0n/a\0n/a\0n/a";
					io-channels = <&exynos_adc 0x01 &exynos_adc 0x03>;
					pinctrl-names = "default";
					status = "okay";
				};
				sec_battery_cable: cable-info {
					default_charging_current = <0x834>;
					default_input_current = <0x708>;
					full_check_current_1st = <0x1db>;
					full_check_current_2nd = <0xfa>;
					current_group_1 {
						cable_number = <0x02 0x13 0x15 0x16 0x17>;
						charging_current = <0x1f4>;
						input_current = <0x1f4>;
					};
					current_group_10 {
						cable_number = <0x0b 0x0e 0x10 0x1c 0x23>;
						charging_current = <0x866>;
						input_current = <0x28a>;
					};
					current_group_11 {
						cable_number = <0x1d 0x25>;
						charging_current = <0x4b0>;
						input_current = <0x1f4>;
					};
					current_group_12 {
						cable_number = <0x01 0x04 0x1e>;
						charging_current = <0x226>;
						input_current = <0x1db>;
					};
					current_group_13 {
						cable_number = <0x22>;
						charging_current = <0x92e>;
						input_current = <0x4b0>;
					};
					current_group_2 {
						cable_number = <0x19 0x1f>;
						charging_current = <0x3e8>;
						input_current = <0x3e8>;
					};
					current_group_3 {
						cable_number = <0x05 0x20>;
						charging_current = <0x5dc>;
						input_current = <0x5dc>;
					};
					current_group_4 {
						cable_number = <0x06 0x07 0x08 0x11 0x12 0x28>;
						charging_current = <0x866>;
						input_current = <0x672>;
					};
					current_group_5 {
						cable_number = <0x09>;
						charging_current = <0x866>;
						input_current = <0x672>;
					};
					current_group_6 {
						cable_number = <0x0a 0x0c 0x0f 0x1b 0x21 0x24>;
						charging_current = <0x866>;
						input_current = <0x320>;
					};
					current_group_7 {
						cable_number = <0x0d>;
						charging_current = <0x866>;
						input_current = <0x2bc>;
					};
					current_group_8 {
						cable_number = <0x18>;
						charging_current = <0x1c2>;
						input_current = <0x3e8>;
					};
					current_group_9 {
						cable_number = <0x1a>;
						charging_current = <0x708>;
						input_current = <0x708>;
					};
				};
				dc_vibrator {
					compatible = "samsung,dc_vibrator";
					dc_vib,motor_type = "COINDC";
					dc_vib,regulator_name = "dc_vib";
					dc_vib-supply = <&l31_reg>;
					status = "okay";
				};
				fixed_regulator0: fixed_regulator@0 {
					compatible = "regulator-fixed";
					enable-active-high;
					gpio = <&gpg1 0x03 0x00>;
					pinctrl-0 = <&ldo_gpio0>;
					pinctrl-names = "default";
					regulator-name = "fixed_regulator0";
				};
				gw3x {
					#gpio-cells = <0x02>;
					VDD_BTP_3P3-supply = <&l26_reg>;
					clock-names = "gate_spi_clk\0ipclk_spi";
					clocks = <&clock 0x239 &clock 0x23d>;
					compatible = "goodix,fingerprint";
					goodix,btp-regulator = "VDD_BTP_3P3";
					goodix,chip_id = "GW36T1";
					goodix,gpio_irq = <&gpa0 0x05 0x00>;
					goodix,gpio_reset = <&gpg1 0x01 0x00>;
					goodix,orient = <0x01>;
					goodix,position = "${fps_position}";
					gpio-controller;
					pinctrl-0 = <&gfspi_rstpin &gfspi_drdypin_suspend>;
					pinctrl-1 = <&gfspi_drdypin_active &spi_fp_clk &spi_fp_cs &spi_fp_miso &spi_fp_mosi>;
					pinctrl-2 = <&gfspi_drdypin_suspend &spi_fp_bus_inactive &spi_fp_miso_inactive>;
					pinctrl-3 = <&gfspi_drdypin_active>;
					pinctrl-4 = <&gfspi_drdypin_suspend>;
					pinctrl-names = "default\0pins_poweron\0pins_poweroff\0pins_poweron_tz\0pins_poweroff_tz";
					reg = <0x00>;
					spi-max-frequency = <0x927c00>;
					controller-data {
						cs-gpio = <&gpp2 0x01 0x00>;
						samsung,spi-chip-select-mode = <0x00>;
						samsung,spi-feedback-delay = <0x00>;
					};
				};
				input_booster {
					#address-cells = <0x01>;
					#size-cells = <0x00>;
					allowed_resources = "1,2,3,4,5,6";
					compatible = "input_booster";
					cpu_cluster_policy = "4,0";
					ib_release_values = "0,0,0,0,0,0,0";
					max_cluster_count = "3";
					max_resource_count = "7";
					status = "okay";
					booster_key@1 {
						input_booster,head_time = <0x1f4>;
						input_booster,label = "key";
						input_booster,tail_time = <0x00>;
						input_booster,type = <0x00>;
						inputbooster,resource {
							compatible = "resource";
							resource@1 {
								resource,label = "cluster1";
								resource,value = <0x163780 0x00>;
							};
							resource@2 {
								resource,label = "cluster0";
								resource,value = <0x163780 0x00>;
							};
							resource@3 {
								resource,label = "mif";
								resource,value = <0x00 0x00>;
							};
							resource@4 {
								resource,label = "int";
								resource,value = <0x00 0x00>;
							};
							resource@5 {
								resource,label = "hmp";
								resource,value = <0x01 0x00>;
							};
							resource@6 {
								resource,label = "ucc";
								resource,value = <0x01 0x00>;
							};
						};
					};
					booster_key@2 {
						input_booster,head_time = <0x00>;
						input_booster,label = "touchkey";
						input_booster,tail_time = <0xc8>;
						input_booster,type = <0x01>;
						inputbooster,resource {
							compatible = "resource";
							resource@1 {
