							};
							resource@2 {
								resource,label = "cluster0";
								resource,value = <0x11a788 0x101148>;
							};
							resource@3 {
								resource,label = "mif";
								resource,value = <0xf78f0 0xf78f0>;
							};
							resource@4 {
								resource,label = "int";
								resource,value = <0x00 0x00>;
							};
							resource@5 {
								resource,label = "hmp";
								resource,value = <0x01 0x01>;
							};
							resource@6 {
								resource,label = "ucc";
								resource,value = <0x01 0x01>;
							};
						};
					};
					booster_key@4 {
						input_booster,head_time = <0x3e8>;
						input_booster,label = "multitouch";
						input_booster,tail_time = <0x1f4>;
						input_booster,type = <0x03>;
						inputbooster,resource {
							compatible = "resource";
							resource@1 {
								resource,label = "cluster1";
								resource,value = <0x11a788 0x101148>;
							};
							resource@2 {
								resource,label = "cluster0";
								resource,value = <0x11a788 0x101148>;
							};
							resource@3 {
								resource,label = "mif";
								resource,value = <0xf78f0 0xf78f0>;
